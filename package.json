{
  "name": "chew-player",
  "productName": "Chew Player",
  "version": "0.2.0",
  "description": "A simple, folder-based music player for macOS and Windows.",
  "author": "fmatsch",
  "license": "MIT",
  "homepage": "https://fmatsch.github.io/chew-player/",
  "repository": "github:fmatsch/chew-player",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.fmatsch.chewplayer",
    "productName": "Chew Player",
    "artifactName": "Chew-Player-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "m4a",
          "ogg",
          "opus",
          "wav",
          "aiff",
          "wma",
          "ape"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fmatsch",
        "repo": "chew-player",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
