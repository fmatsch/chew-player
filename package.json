{
  "name": "chew-player",
  "productName": "Chew Player",
  "version": "0.3.14",
  "description": "A simple, folder-based music and video player for macOS and Windows.",
  "author": "fmatsch",
  "license": "MIT",
  "homepage": "https://fmatsch.github.io/chew-player/",
  "repository": "github:fmatsch/chew-player",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "npm run build:native && electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "build:native": "sh scripts/build-airplay-helper.sh"
  },
  "build": {
    "appId": "io.github.fmatsch.chewplayer",
    "productName": "Chew Player",
    "artifactName": "Chew-Player-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Chew Player looks for Apple TVs, Chromecasts and smart TVs on your network so you can play videos and music on them.",
        "NSBonjourServices": [
          "_airplay._tcp",
          "_googlecast._tcp",
          "_raop._tcp"
        ]
      },
      "extraResources": [
        {
          "from": "build/native/chew-airplay",
          "to": "chew-airplay"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "m4a",
          "ogg",
          "opus",
          "wav",
          "aiff",
          "wma",
          "ape"
        ],
        "name": "Audio",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "mkv",
          "m4v",
          "mov",
          "avi",
          "webm"
        ],
        "name": "Video",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fmatsch",
        "repo": "chew-player",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "electron-updater": "^6.8.9",
    "fast-srp-hap": "^2.0.4",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
